# ---------- Storage: a GitHub repository (required in production) ----------
# Create a PRIVATE repository just for data, e.g. yourname/logbook-data.
# Token: GitHub > Settings > Developer settings > Fine-grained tokens.
#   Repository access: only that repository.  Permissions: Contents = Read and write.
GITHUB_TOKEN=
GITHUB_REPO=yourname/logbook-data
GITHUB_BRANCH=main
# Folder inside the repository; files go to <dir>/users/<user id>/*.json
GITHUB_DATA_DIR=data
# For GitHub Enterprise Server: https://your-host/api/v3
# GITHUB_API_URL=

# ---------- Sign-in (pick one) ----------
# Option A, one person: a password. Data is stored under users/me/.
APP_PASSWORD=
# Option B, one or more people: a GitHub OAuth App
#   (GitHub > Settings > Developer settings > OAuth Apps; callback URL: https://your-domain/api/auth/callback)
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# Comma-separated GitHub usernames allowed to sign in. Each gets their own folder.
# ALLOWED_GITHUB_USERS=yourname,friendname
# Public URL of the app (needed behind some proxies for the OAuth callback)
# APP_URL=https://logbook.example.com

# Required in production: at least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# ---------- AI features (optional) ----------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# AI_REQUESTS_PER_10_MIN=40

# ---------- Local development ----------
# Without GITHUB_TOKEN, `npm run dev` stores data in ./.data and skips sign-in.
# STORAGE=fs          # force the local folder store (also works in production on one machine)
# DATA_DIR=.data
