    },
    {
     "topic": "Time response",
     "concepts": [
      "Transient response of LTI systems",
      "Steady-state error"
     ]
    },
    {
     "topic": "Stability",
     "concepts": [
      {
       "name": "Routh–Hurwitz criterion",
       "prereq": [
        "Transfer function"
       ]
      },
      {
       "name": "Nyquist criterion",
       "prereq": [
        "Bode plots"
       ]
      },
      {
       "name": "Root locus",
       "prereq": [
        "Transfer function"
       ]
      }
     ]
    },
    {
     "topic": "Frequency response",
     "concepts": [
      {
       "name": "Bode plots",
       "prereq": [
        "Transfer function"
       ]
      }
     ]
    },
    {
     "topic": "Compensators and controllers",
     "concepts": [
      "Lag, lead and lead–lag compensators",
